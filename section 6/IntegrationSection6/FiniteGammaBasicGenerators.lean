import IntegrationSection6.FiniteGammaGradedGenerators
import IntegrationSection6.FiniteGammaBasicRelation

/-! In the graded sum of the full finite-volume RV[k] categories, Isp
is generated by one degree-one pair. Its positive object includes the
absorbing point in degree one. The later nonzero-label compression and
deformation to the paper's j-1 relation are separate obligations. -/
noncomputable section
set_option backward.isDefEq.respectTransparency false
open Classical FirstOrder FirstOrder.Language
open SpecialTransformations.Milestone0 SpecialTransformations.Milestone0.LRV
open SpecialTransformations.Section3 SpecialTransformations.Section3.GammaParameters
open SpecialTransformations.Section4 SpecialTransformations.Section5
namespace IntegrationInACVF.Section6.FiniteRV
variable {M : Type} [sM : LRV.Structure M] [hM : M ⊨ Axioms.ACVF]
variable {B : Base (M := M)} {S : Set M} [hBS : Fact (B.real ⊆ S)]
variable {κ : Cardinal} (hκ : Cardinal.aleph0 ≤ κ) (hs : Saturated M κ)
variable (h00 : M ⊨ Axioms.ACVF00) (hsmall : Cardinal.mk B.real < κ)

theorem gammaIspRingConAt_least_basic (q : RingCon (GammaGradedClassesAt B S))
    (hbasic : q (gammaGradedClassAt (gammaOneAt hBS.out)) (gammaGradedClassAt (gammaPositiveAt hBS.out))) :
    gammaIspRingConAt hκ hs h00 hsmall ≤ q := by
  apply gammaIspRingConAt_least hκ hs h00 hsmall
  intro n U i hAd
  cases n with
  | zero => exact i.elim0
  | succ n =>
    let V := gammaDeleteVolumeAt hκ hs h00 hsmall U i hAd
    have hu : gammaGradedClassAt U = gammaGradedClassAt (gammaProductAt V (gammaOneAt hBS.out)) :=
      congrArg (DirectSum.of (GammaIsoClassesAt B S) (n+1))
        (gammaIsoClassAt_iso (gammaAdmissibleFactorOne hκ hs h00 hsmall U i hAd))
    have he : gammaGradedClassAt (gammaElementaryAt hκ hs h00 hsmall U i hAd) =
        gammaGradedClassAt (gammaProductAt V (gammaPositiveAt hBS.out)) :=
      congrArg (DirectSum.of (GammaIsoClassesAt B S) (n+1))
        (gammaIsoClassAt_iso (gammaAdmissibleFactorPositive hκ hs h00 hsmall U i hAd))
    rw [hu,he,gammaGradedClassAt_product,gammaGradedClassAt_product]
    exact q.mul (q.refl _) hbasic

def gammaBasicGradedRelationAt (a b : GammaGradedClassesAt B S) : Prop :=
  a = gammaGradedClassAt (gammaOneAt hBS.out) ∧ b = gammaGradedClassAt (gammaPositiveAt hBS.out)

theorem gammaIspRingConAt_eq_basic : gammaIspRingConAt (S := S) hκ hs h00 hsmall =
    ringConGen (gammaBasicGradedRelationAt (B := B) (S := S)) := by
  apply le_antisymm
  · apply gammaIspRingConAt_least_basic hκ hs h00 hsmall
    exact RingConGen.Rel.of _ _ ⟨rfl,rfl⟩
  · apply RingCon.ringConGen_le.mpr
    rintro a b ⟨rfl,rfl⟩
    exact (gammaIspRingConAt_class_iff hκ hs h00 hsmall _ _).mpr
      (gammaBasic_ispAt hκ hs h00 hsmall hBS.out)

end IntegrationInACVF.Section6.FiniteRV
