/-!
# Finite blowup iteration: the combinatorial part

This module proves the finite grid argument used in Lemma 6.5 and the
transitivity argument used in Lemma 6.8 of arXiv:0809.0473v2. It is generic
in the one-step relation. The geometric diamond property for RV blowups
must be proved separately; it is an explicit premise here.
-/

namespace IntegrationInACVF.Section6.Iteration

universe u
variable {α : Type u}

/-- Exactly `n` forward steps, with no backward steps or equivalence closure. -/
inductive Steps (R : α → α → Prop) : Nat → α → α → Prop
  | refl (a : α) : Steps R 0 a a
  | cons {n : Nat} {a b c : α} : R a b → Steps R n b c → Steps R (n + 1) a c

namespace Steps

variable {R : α → α → Prop} {a b c : α} {m n : Nat}

theorem single (h : R a b) : Steps R 1 a b := .cons h (.refl b)

theorem trans (h : Steps R m a b) (g : Steps R n b c) : Steps R (m + n) a c := by
  induction h with
  | refl => simpa using g
  | cons h _ ih => simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using cons h (ih g)

theorem map {β : Type u} {T : β → β → Prop} (f : α → β)
    (hf : ∀ {x y}, R x y → T (f x) (f y)) (h : Steps R n a b) :
    Steps T n (f a) (f b) := by
  induction h with
  | refl => exact .refl _
  | cons h _ ih => exact .cons (hf h) ih

theorem invariant {β : Sort _} (f : α → β)
    (hf : ∀ {x y}, R x y → f x = f y) (h : Steps R n a b) : f a = f b := by
  induction h with
  | refl => rfl
  | cons h _ ih => exact (hf h).trans ih

end Steps

/-- A common one-step refinement, with one further step on each side. -/
def Diamond (R : α → α → Prop) : Prop :=
  ∀ {a b c}, R a b → R a c → ∃ d, R b d ∧ R c d

/-- One side of the finite grid. -/
theorem strip {R : α → α → Prop} (hd : Diamond R) {a b c : α} {n : Nat}
    (hab : R a b) (hac : Steps R n a c) :
    ∃ d, Steps R n b d ∧ R c d := by
  induction hac generalizing b with
  | refl => exact ⟨b, .refl b, hab⟩
  | cons hac _ ih =>
    obtain ⟨e, hbe, hce⟩ := hd hab hac
    obtain ⟨d, hed, hcd⟩ := ih hce
    exact ⟨d, .cons hbe hed, hcd⟩

/-- The length-preserving grid argument of Lemma 6.5, conditional on the
one-step geometric diamond. Neither confluence nor a Section 6 conclusion
is hidden in the definition of finite iteration. -/
theorem grid {R : α → α → Prop} (hd : Diamond R) {a b c : α} {m n : Nat}
    (hab : Steps R m a b) (hac : Steps R n a c) :
    ∃ d, Steps R n b d ∧ Steps R m c d := by
  induction hab generalizing c with
  | refl => exact ⟨c, hac, .refl c⟩
  | cons hab _ ih =>
    obtain ⟨e, hbe, hce⟩ := strip hd hab hac
    obtain ⟨d, hbd, hed⟩ := ih hbe
    exact ⟨d, hbd, .cons hce hed⟩

/-- Common forward refinement, as opposed to the equivalence relation
freely generated by the one-step relation. -/
def Common (R : α → α → Prop) (a b : α) : Prop :=
  ∃ c m n, Steps R m a c ∧ Steps R n b c

namespace Common

variable {R : α → α → Prop} {a b c : α}

theorem refl (a : α) : Common R a a := ⟨a, 0, 0, .refl a, .refl a⟩

theorem symm (h : Common R a b) : Common R b a := by
  obtain ⟨d, m, n, ha, hb⟩ := h
  exact ⟨d, n, m, hb, ha⟩

/-- Transitivity in Lemma 6.8 follows from the diamond, rather than being
assumed by using an equivalence closure as the definition of `Isp`. -/
theorem trans (hd : Diamond R) (hab : Common R a b) (hbc : Common R b c) :
    Common R a c := by
  obtain ⟨d, m, n, had, hbd⟩ := hab
  obtain ⟨e, p, q, hbe, hce⟩ := hbc
  obtain ⟨f, hdf, hef⟩ := grid hd hbd hbe
  exact ⟨f, m + p, q + n, had.trans hdf, hce.trans hef⟩

theorem invariant {β : Sort _} (f : α → β)
    (hf : ∀ {x y}, R x y → f x = f y) (h : Common R a b) : f a = f b := by
  obtain ⟨c, m, n, ha, hb⟩ := h
  exact (ha.invariant f hf).trans (hb.invariant f hf).symm

end Common

/-- Conditional quotient used after the geometric diamond is discharged. -/
def commonSetoid {R : α → α → Prop} (hd : Diamond R) : Setoid α where
  r := Common R
  iseqv := ⟨Common.refl, Common.symm, Common.trans hd⟩

/-- An invariant of elementary steps descends to common-refinement classes. -/
def descend {R : α → α → Prop} (hd : Diamond R) {β : Sort _}
    (f : α → β) (hf : ∀ {x y}, R x y → f x = f y) :
    Quotient (commonSetoid (R := R) hd) → β :=
  Quotient.lift f (fun _ _ h => h.invariant f hf)

@[simp] theorem descend_mk {R : α → α → Prop} (hd : Diamond R) {β : Sort _}
    (f : α → β) (hf : ∀ {x y}, R x y → f x = f y) (a : α) :
    descend hd f hf (Quotient.mk (commonSetoid (R := R) hd) a) = f a := rfl

/-- The injectivity half of the quotient argument in Proposition 6.18.
The kernel identification remains an explicit geometric input. -/
theorem descend_injective {R : α → α → Prop} (hd : Diamond R) {β : Sort _}
    (f : α → β) (hf : ∀ {x y}, R x y → f x = f y)
    (hkernel : ∀ {a b}, f a = f b → Common R a b) :
    ∀ q r, descend hd f hf q = descend hd f hf r → q = r := by
  intro q r
  induction q using Quotient.inductionOn with
  | h a =>
    induction r using Quotient.inductionOn with
    | h b =>
      intro he
      exact Quotient.sound (hkernel he)

/-- Surjectivity of lifting passes to the common-refinement quotient. -/
theorem descend_surjective {R : α → α → Prop} (hd : Diamond R) {β : Sort _}
    (f : α → β) (hf : ∀ {x y}, R x y → f x = f y)
    (hsurj : ∀ b, ∃ a, f a = b) :
    ∀ b, ∃ q, descend hd f hf q = b := by
  intro b
  obtain ⟨a, ha⟩ := hsurj b
  exact ⟨Quotient.mk (commonSetoid (R := R) hd) a, ha⟩

/-- The representative-independent inverse after surjectivity and the
kernel identification are proved. This is only the set-level argument;
additive and multiplicative compatibility belong to the actual quotients. -/
noncomputable def inverse {R : α → α → Prop} (hd : Diamond R) {β : Sort _}
    (f : α → β) (hsurj : ∀ b, ∃ a, f a = b) (b : β) :
    Quotient (commonSetoid (R := R) hd) :=
  Quotient.mk _ (Classical.choose (hsurj b))

theorem descend_inverse {R : α → α → Prop} (hd : Diamond R) {β : Sort _}
    (f : α → β) (hf : ∀ {x y}, R x y → f x = f y)
    (hsurj : ∀ b, ∃ a, f a = b) (b : β) :
    descend hd f hf (inverse hd f hsurj b) = b := Classical.choose_spec (hsurj b)

theorem inverse_descend {R : α → α → Prop} (hd : Diamond R) {β : Sort _}
    (f : α → β) (hf : ∀ {x y}, R x y → f x = f y)
    (hsurj : ∀ b, ∃ a, f a = b)
    (hkernel : ∀ {a b}, f a = f b → Common R a b)
    (q : Quotient (commonSetoid (R := R) hd)) :
    inverse hd f hsurj (descend hd f hf q) = q := by
  apply descend_injective hd f hf hkernel
  exact descend_inverse hd f hf hsurj _

end IntegrationInACVF.Section6.Iteration
