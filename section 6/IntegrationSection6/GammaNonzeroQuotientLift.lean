import IntegrationSection6.GammaThroughLiftCompatibility
import IntegrationSection6.FiniteNonzeroIntegration

/-! Actual semiring lifting descends through finite-stage Isp generators. -/
noncomputable section
set_option backward.isDefEq.respectTransparency false
open Classical FirstOrder FirstOrder.Language
open SpecialTransformations.Milestone0 SpecialTransformations.Milestone0.LRV
open SpecialTransformations.Section3 SpecialTransformations.Section3.GammaParameters
open SpecialTransformations.Section4 SpecialTransformations.Section5 SpecialTransformations.Section7
open SpecialTransformations.Section4.PositiveAdditiveGrothendieck
namespace IntegrationInACVF.Section6.FiniteRV
variable {M : Type} [sM : LRV.Structure M] [hM : M ⊨ Axioms.ACVF]
variable {B : Base (M := M)} {k : ℕ}
local instance : Fact (B.real ⊆ (Set.univ : Set M)) := ⟨Set.subset_univ _⟩

variable {κ : Cardinal}
variable (hκ : Cardinal.aleph0 ≤ κ) (hs : Saturated M κ) (h00 : M ⊨ Axioms.ACVF00)
variable (hsmall : Cardinal.mk B.real < κ) (hB : VFGammaGeneratedBase B)

theorem gammaAllLiftClassesAt_isp (a b : GammaIsoClassesAt B Set.univ k)
    (h : gammaClassIspAt hκ hs h00 hsmall a b) :
    gammaAllLiftClassesAt hκ hs h00 hsmall hB a = gammaAllLiftClassesAt hκ hs h00 hsmall hB b := by
  obtain ⟨U,V,rfl,rfl,H⟩ := h
  rw [gammaAllLiftClassesAt_class,gammaAllLiftClassesAt_class]
  exact PositiveGrothendieck.of_iso (gammaVFAllPositivePresentation B) (H.liftIsoNative hB)

def gammaNonzeroIspRelation (a b : GammaNonzeroGradedAt (B := B) (S := Set.univ)) : Prop :=
  ∃ n, ∃ x y : GammaNonzeroThroughAt (B := B) (S := Set.univ) n,
    gammaThroughToGradedAt n x = a ∧ gammaThroughToGradedAt n y = b ∧ gammaNonzeroThroughIspAt hκ hs h00 hsmall n x y

/-- The semiring congruence generated by actual finite-stage Isp pairs.
Equality with the finite-stage union is a separate compatibility theorem. -/
def gammaNonzeroIspRingCon : RingCon (GammaNonzeroGradedAt (B := B) (S := Set.univ)) :=
  ringConGen (gammaNonzeroIspRelation hκ hs h00 hsmall)

theorem gammaNonzeroIspRingCon_le_lift_kernel : gammaNonzeroIspRingCon (B := B) hκ hs h00 hsmall ≤
    RingCon.ker (gammaNonzeroGlobalLiftAt (S := Set.univ) hκ hs h00 hsmall hB) := by
  apply RingCon.ringConGen_le.mpr
  rintro a b ⟨n,x,y,rfl,rfl,H⟩
  change gammaNonzeroGlobalLiftAt hκ hs h00 hsmall hB (gammaThroughToGradedAt n x) =
    gammaNonzeroGlobalLiftAt hκ hs h00 hsmall hB (gammaThroughToGradedAt n y)
  rw [gammaNonzeroGlobalLiftAt_through,gammaNonzeroGlobalLiftAt_through]
  exact gammaAllLiftClassesAt_isp hκ hs h00 hsmall hB _ _ H

def gammaNonzeroQuotientLift : (gammaNonzeroIspRingCon (B := B) hκ hs h00 hsmall).Quotient →+* GammaVFAllKPlus B :=
  (gammaNonzeroIspRingCon hκ hs h00 hsmall).lift (gammaNonzeroGlobalLiftAt hκ hs h00 hsmall hB)
    (gammaNonzeroIspRingCon_le_lift_kernel hκ hs h00 hsmall hB)

theorem gammaNonzeroQuotientLift_class (U : GammaObjectAt B Set.univ k) :
    gammaNonzeroQuotientLift hκ hs h00 hsmall hB
      ((gammaNonzeroIspRingCon hκ hs h00 hsmall).mk' (gammaNonzeroResolutionAt k (gammaIsoClassAt U))) =
        gammaAllLiftClass U.toGamma := by
  change gammaNonzeroGlobalLiftAt hκ hs h00 hsmall hB (gammaNonzeroResolutionAt k (gammaIsoClassAt U)) = _
  rw [gammaNonzeroGlobalLiftAt_resolution,gammaAllLiftClassesAt_class]

end IntegrationInACVF.Section6.FiniteRV
