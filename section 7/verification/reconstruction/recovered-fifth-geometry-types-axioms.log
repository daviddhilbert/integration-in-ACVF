                            (∀ (u : ↑L.essential.obj.domain.carrier),
                                V.essentialForm.value ((finiteIsoMap f.iso).toFun (i.toFun u)) =
                                  R.essentialForm.value ((finiteIsoMap e).toFun u)) →
