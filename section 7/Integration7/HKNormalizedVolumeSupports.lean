module

public import Integration7.HKNormalizedFunctionGenerators
public import Integration7.HKSupportedGradedVolumeFunctions
public import Integration7.RawPositiveCoordinateSupports

@[expose] public section

/-! Supported normalized functions are the submodule generated by
actual supported positive homogeneous functions. Actual weighted-zero
supported functions belong too, by the proved normalized point relation. -/
noncomputable section
set_option backward.isDefEq.respectTransparency false
open FirstOrder FirstOrder.Language
open SpecialTransformations.Milestone0 SpecialTransformations.Milestone0.LRV
open SpecialTransformations.Milestone0.Transfer
open SpecialTransformations.Section3 SpecialTransformations.Section4
open SpecialTransformations.DefinableGeometry

namespace IntegrationInACVF.Section7.HK
variable {M : Type} [LRV.Structure M] [M ⊨ Axioms.ACVF] {n a p : ℕ}
variable (hc : CanonicalStructure.IsCanonical (M := M)) (C : BaseContext M)

def normalizedVolumeSupportGenerators
    (X : DefSet (rawVFSpace (M := M) (n+1)) (C.base : Set M)) : Set (NormalizedVolumeFunction hc C n) :=
  {v | ∃ (k : ℕ) (f : SupportedAERVVolumeFunction hc C X k),
    v=normalizedPositiveVolumeFunction hc C n k (supportedVolumeFunctionForget hc C X f)}

def normalizedVolumeSupport
    (X : DefSet (rawVFSpace (M := M) (n+1)) (C.base : Set M)) :
    Submodule (NormalizedRVVolumeRing hc C) (NormalizedVolumeFunction hc C n) :=
  Submodule.span (NormalizedRVVolumeRing hc C) (normalizedVolumeSupportGenerators hc C X)

abbrev NormalizedSupportedVolumeFunction
    (X : DefSet (rawVFSpace (M := M) (n+1)) (C.base : Set M)) := normalizedVolumeSupport hc C X

theorem normalized_positive_generator_has_support
    (X : DefSet (rawVFSpace (M := M) (n+1)) (C.base : Set M)) (k : ℕ)
    (f : AERVVolumeFunction hc C n k) (hf : HasRawPositiveVolumeSupport hc C X f) :
    normalizedPositiveVolumeFunction hc C n k f ∈ normalizedVolumeSupport hc C X := by
  obtain ⟨g,rfl⟩ := hf
  exact Submodule.subset_span ⟨k,g,rfl⟩

theorem zero_positive_product_supported
    {X : DefSet (rawVFSpace (M := M) (n+1)) (C.base : Set M)}
    (F : ZeroVFVolumeFamily C (n+1) a) (U : PositiveRVVolumeObject (M := M) (C.base : Set M) p)
    (hF : ∀ q : F.domain, q.val.1 ∈ X.carrier) :
    ∀ q : (selectedZeroFamilyPositiveProduct U F).domain, q.val.1 ∈ X.carrier := by
  intro q
  let H := F.mulConstant U
  let r := mixedRVMapGraphProjection H.volume q
  let t := Map.prodFst F.domain U.underlying.obj.domain (mixedRVFactorUnpack F.domain U.underlying.obj.domain r)
  have hr : r.val.1=q.val.1 := congrArg Prod.fst (mixed_rv_map_graph_projection_value H.volume q)
  have ht : t.val.1=r.val.1 := congrArg (fun z => z.1.1)
    (mixed_rv_factor_unpack_value F.domain U.underlying.obj.domain r)
  exact (ht.trans hr) ▸ hF t

theorem normalized_zero_generator_has_support
    (X : DefSet (rawVFSpace (M := M) (n+1)) (C.base : Set M))
    (f : SupportedAEZeroVolumeFunction hc C X) :
    normalizedVolumeFunctionGenerator hc C n (DirectSum.of (AEVolumeFunctionComponent hc C n) 0
      (supportedZeroVolumeFunctionForget hc C X f)) ∈ normalizedVolumeSupport hc C X := by
  rw [normalized_zero_function_positive_generator]
  apply normalized_positive_generator_has_support hc C X 0
  induction f using Quotient.inductionOn with
  | h F =>
    exact ⟨Quotient.mk _ ⟨_,⟨selectedZeroFamilyPositiveProduct
      (degreeOnePointVolumeObject (C.base : Set M)) F.2.val,
      zero_positive_product_supported C F.2.val _ F.2.property⟩⟩,rfl⟩

theorem normalized_supported_graded_generator_has_support
    (X : DefSet (rawVFSpace (M := M) (n+1)) (C.base : Set M))
    (f : SupportedGradedVolumeFunction hc C X) :
    normalizedVolumeFunctionGenerator hc C n (supportedGradedVolumeForgetAddHom hc C X f) ∈
      normalizedVolumeSupport hc C X := by
  induction f using DirectSum.induction_on with
  | zero => simpa only [map_zero] using (normalizedVolumeSupport hc C X).zero_mem
  | add f g hf hg =>
    simp only [map_add]
    exact (normalizedVolumeSupport hc C X).add_mem hf hg
  | of j f =>
    rw [supported_graded_volume_forget_of]
    cases j with
    | zero => exact normalized_zero_generator_has_support hc C X f
    | succ k => exact normalized_positive_generator_has_support hc C X k _ ⟨f,rfl⟩

end IntegrationInACVF.Section7.HK
