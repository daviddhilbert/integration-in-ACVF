import Integration7.GammaNamesVolumeContexts
import Integration7.GammaNamesGenericParameters

/-! The code context of a Gamma-named base. Objects definable over the
Gamma-named base `⟨C.base, Ξ⟩` are coded over the substructure generated by
`C.base` together with the proof-only common names of that base (the
existing `gammaNamesContainingVolumeContext`). This context is only a code
set: the Gamma-named categories built on it require Gamma-definability over
the original base `⟨C.base, Ξ⟩`, and no hypothesis puts the common names
into the original base. -/
noncomputable section
set_option backward.isDefEq.respectTransparency false
open FirstOrder FirstOrder.Language
open SpecialTransformations.Milestone0 SpecialTransformations.Milestone0.LRV
open SpecialTransformations.Milestone0.Transfer
open SpecialTransformations.Section3 SpecialTransformations.Section3.GammaParameters

namespace IntegrationInACVF.Section7
variable {M : Type} [LRV.Structure M] [M ⊨ Axioms.ACVF]

/-- The Gamma-named base of a context: its real base and the Gamma points `Ξ`. -/
abbrev gammaNamedBase (C : BaseContext M) (Ξ : Set (Values.Gamma (M := M))) : Base (M := M) :=
  ⟨(C.base : Set M),Ξ⟩

/-- The small code context of the Gamma-named base `⟨C.base, Ξ⟩`. -/
abbrev gammaNamedCodeContext (C : BaseContext M) (Ξ : Set (Values.Gamma (M := M)))
    (hΞ : Cardinal.mk Ξ < C.κ) : BaseContext M :=
  gammaNamesContainingVolumeContext C (gammaNamedBase C Ξ) (Set.Subset.refl _) hΞ

variable (C : BaseContext M) (Ξ : Set (Values.Gamma (M := M))) (hΞ : Cardinal.mk Ξ < C.κ)

theorem gamma_named_code_context_base :
    (C.base : Set M) ⊆ ((gammaNamedCodeContext C Ξ hΞ).base : Set M) :=
  fun _ h => gamma_names_containing_volume_context_contains C _ _ hΞ (Or.inl h)

theorem gamma_named_code_context_names :
    commonRealNames (gammaNamedBase C Ξ) ⊆ ((gammaNamedCodeContext C Ξ hΞ).base : Set M) :=
  fun _ h => gamma_names_containing_volume_context_contains C _ _ hΞ (Or.inr h)

@[simp] theorem gamma_named_code_context_kappa : (gammaNamedCodeContext C Ξ hΞ).κ = C.κ := rfl

theorem gamma_named_code_context_generic (hc : CanonicalStructure.IsCanonical (M := M))
    {p : ℕ} (x : Fin p → VFType (M := M))
    (hx : AlgebraicIndependent (vfParameterField (gammaNamedBase C Ξ).real) x) :
    AlgebraicIndependent (vfParameterField ((gammaNamedCodeContext C Ξ hΞ).base : Set M)) x :=
  gamma_names_context_preserves_independence hc C _ _ hΞ rfl x hx

end IntegrationInACVF.Section7
