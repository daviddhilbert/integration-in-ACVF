import Integration7.GammaNamedBasicGeneration
import Integration7.HKPrincipalVolumeKernel

/-! **Gamma-named Theorem 7.13.** The kernel of the projection from the
Grothendieck ring of Gamma-named RV isomorphism classes to the ring of
Gamma-named blowup classes is the two-sided ideal generated by
`[point] - [cone]`; composing with Gamma-named Theorem 7.10 identifies the
Gamma-named VF class ring with the quotient. No hypothesis puts the common
names of `⟨C.base, Ξ⟩` into `C.base`. -/
noncomputable section
set_option backward.isDefEq.respectTransparency false
open FirstOrder FirstOrder.Language CategoryTheory
open SpecialTransformations.Milestone0 SpecialTransformations.Milestone0.LRV
open SpecialTransformations.Section3 SpecialTransformations.Section3.GammaParameters
open SpecialTransformations.Section4 SpecialTransformations.DefinableGeometry SpecialTransformations.Section9
open SpecialTransformations.Section5 (Point GammaSetDefinable GammaGraphDefinable gammaLogicInput)
open IntegrationInACVF.Section6

namespace IntegrationInACVF.Section7.HK
variable {M : Type} [LRV.Structure M] [M ⊨ Axioms.ACVF] {B : Base (M := M)}

set_option allowUnsafeReducibility true in
attribute [local reducible] degreeOneHeadFactor zeroProduct multiplyForm
  PositiveRVVolumeObject.zero_prod rvFiniteProductObject admissibleHeadFiniteObject

theorem ZeroRVVolumeObject.Gamma.degreeOneHead (hc : CanonicalStructure.IsCanonical (M := M)) (C : BaseContext M)
    {U : PositiveRVVolumeObject (M := M) (C.base : Set M) 0} (hU : VolumeObjectGamma U B)
    (h : BlowupAdmissible U) : (degreeOneHeadFactor C U h).Gamma B :=
  ⟨hU.domain_graph,(RVMapGamma.scalarMul hc hU.density (hU.coordinates.select hc _)).congr (fun _ => rfl)⟩

theorem degree_one_head_point_map_raw (C : BaseContext M)
    (U : PositiveRVVolumeObject (M := M) (C.base : Set M) 0) (h : BlowupAdmissible U)
    (u : U.underlying.obj.domain) :
    (degreeOneHeadPointMap C U h u).val = u.val ∘ Fin.cast (Nat.add_zero _) := by
  change Fin.append u.val _ = _
  exact Fin.append_right_nil _ _ rfl

theorem gamma_degree_one_head_point_iso (hc : CanonicalStructure.IsCanonical (M := M)) (C : BaseContext M)
    {U : PositiveRVVolumeObject (M := M) (C.base : Set M) 0} (hU : VolumeObjectGamma U B)
    (h : BlowupAdmissible U) : (degreeOneHeadPointVolumeIso C U h).GammaDefinable B :=
  gamma_volume_iso_of_full_map _ (degreeOneHeadPointMap C U h)
    (gamma_essential_volume_domain _ hU.coordinates)
    (gamma_rv_coordinate_map hc _ _ hU.domain_graph (degree_one_head_point_map_raw C U h)) (fun _ => rfl)

theorem gamma_degree_one_head_cone_iso (hc : CanonicalStructure.IsCanonical (M := M)) (C : BaseContext M)
    {U W : PositiveRVVolumeObject (M := M) (C.base : Set M) 0} (b : ElementaryBlowup U W)
    (hU : VolumeObjectGamma U B) (hW : VolumeObjectGamma W B) (hb : RVMapGamma b.packedChartMap B) :
    ∃ e : RVVolumeIso W (zeroProduct (degreeOneHeadFactor C U b.admissible)
      (degreeOneConeVolumeObject (C.base : Set M))), e.GammaDefinable B := by
  let H := degreeOneHeadFactor C U b.admissible
  let P := degreeOnePointVolumeObject (M := M) (C.base : Set M)
  have hAd := degreeOnePointAdmissible hc (C.base : Set M)
  let e := elementaryVolumeBlowup C P hAd
  have hH : H.Gamma B := ZeroRVVolumeObject.Gamma.degreeOneHead hc C hU b.admissible
  have hP : VolumeObjectGamma P B := VolumeObjectGamma.degreeOnePoint hc _
  have hHP : VolumeObjectGamma (zeroProduct H P) B := hP.zeroProd hc hH
  have hEP := VolumeObjectGamma.elementary_canonical hc C P hP hAd
  have hHE : VolumeObjectGamma (zeroProduct H (elementaryVolumeObject C P hAd)) B := hEP.zeroProd hc hH
  have hCone : VolumeObjectGamma (degreeOneConeVolumeObject (M := M) (C.base : Set M)) B :=
    VolumeObjectGamma.degreeOneCone hc _
  obtain ⟨f,hf⟩ := exists_gamma_elementaryBlowupIso hc C B (degreeOneHeadPointVolumeIso C U b.admissible)
    b (weightedZeroElementary e H) hU.coordinates hHP.coordinates hU.density hHP.density
    (gamma_degree_one_head_point_iso hc C hU b.admissible)
    (b.gamma_essential_packed_chart hW hb)
    ((weightedZeroElementary e H).gamma_essential_packed_chart hHE
      (gamma_weighted_zero_packed_chart hc e H hH (gamma_canonical_full_packed_chart hc C P hAd hP)))
  exact ⟨f.trans hc C (zeroProductIso hc C (ZeroRVVolumeIso.refl H) (degreeOneBasicElementaryIso hc C)),
    hf.trans hc C B (gamma_zero_product_iso hc C hEP hCone hH hH hH.refl_iso
      (gamma_degree_one_basic_elementary_iso hc C))⟩

variable (hc : CanonicalStructure.IsCanonical (M := M)) (C : BaseContext M)
variable (Ξ : Set (Values.Gamma (M := M))) (hΞ : Cardinal.mk Ξ < C.κ)

set_option quotPrecheck false
local notation "𝔅" => gammaNamedBase C Ξ
local notation "𝔇" => gammaNamedCodeContext C Ξ hΞ
local notation "𝔖" => ((gammaNamedCodeContext C Ξ hΞ).base : Set M)

/-- The class of a Gamma all-degree object in the graded isomorphism-class semiring. -/
def gammaIsoSemiringClass {n : ℕ} (U : GammaRVObjects 𝔅 𝔖 n) : GammaNamedRVIsoSemiring hc C Ξ hΞ :=
  DirectSum.of (GammaNamedRVIsoClasses hc C Ξ hΞ) n (gammaNamedRVIsoClass hc C Ξ hΞ U)

/-- A positive Gamma volume object as an all-degree Gamma object. -/
def GammaVolumeObjects.toAll {k : ℕ} (U : GammaVolumeObjects 𝔅 𝔖 k) : GammaRVObjects 𝔅 𝔖 (k+1) :=
  ⟨U.val,(RVVolumeObject.Gamma.positive_iff U.val).mpr U.property⟩

def gammaPoint : GammaRVObjects 𝔅 𝔖 1 :=
  ⟨degreeOnePointVolumeObject 𝔖,(RVVolumeObject.Gamma.positive_iff _).mpr (VolumeObjectGamma.degreeOnePoint hc _)⟩

def gammaCone : GammaRVObjects 𝔅 𝔖 1 :=
  ⟨degreeOneConeVolumeObject 𝔖,(RVVolumeObject.Gamma.positive_iff _).mpr (VolumeObjectGamma.degreeOneCone hc _)⟩

theorem gamma_iso_semiring_class_mul {n m : ℕ} (U : GammaRVObjects 𝔅 𝔖 n) (V : GammaRVObjects 𝔅 𝔖 m) :
    gammaIsoSemiringClass hc C Ξ hΞ U * gammaIsoSemiringClass hc C Ξ hΞ V =
      gammaIsoSemiringClass hc C Ξ hΞ (U.product hc V) := by
  rw [gammaIsoSemiringClass,gammaIsoSemiringClass,DirectSum.of_mul_of]
  exact congrArg (DirectSum.of (GammaNamedRVIsoClasses hc C Ξ hΞ) (n+m))
    (gammaNamedRVIsoMul_class hc C Ξ hΞ U V)

theorem gamma_iso_semiring_class_iso {k : ℕ} {U V : GammaVolumeObjects 𝔅 𝔖 k}
    (e : RVVolumeIso U.val V.val) (he : e.GammaDefinable 𝔅) :
    gammaIsoSemiringClass hc C Ξ hΞ (GammaVolumeObjects.toAll C Ξ hΞ U) =
      gammaIsoSemiringClass hc C Ξ hΞ (GammaVolumeObjects.toAll C Ξ hΞ V) :=
  congrArg (DirectSum.of (GammaNamedRVIsoClasses hc C Ξ hΞ) (k+1)) (gammaVolumeIsoClass_iso hc 𝔇 𝔅 e he)

theorem gamma_iso_semiring_class_coprod {k : ℕ} (U V : GammaVolumeObjects 𝔅 𝔖 k) :
    gammaIsoSemiringClass hc C Ξ hΞ (GammaVolumeObjects.toAll C Ξ hΞ (U.coprod V)) =
      gammaIsoSemiringClass hc C Ξ hΞ (GammaVolumeObjects.toAll C Ξ hΞ U) +
        gammaIsoSemiringClass hc C Ξ hΞ (GammaVolumeObjects.toAll C Ξ hΞ V) := by
  rw [gammaIsoSemiringClass,gammaIsoSemiringClass,gammaIsoSemiringClass,← map_add]
  rfl

/-- Elementary Gamma factorization in the isomorphism-class semiring. -/
theorem gamma_elementary_semiring_factorization {k : ℕ} {U W : GammaVolumeObjects 𝔅 𝔖 k}
    (b : ElementaryBlowup U.val W.val) (hb : RVMapGamma b.packedChartMap 𝔅) :
    ∃ x : GammaNamedRVIsoSemiring hc C Ξ hΞ,
      gammaIsoSemiringClass hc C Ξ hΞ (GammaVolumeObjects.toAll C Ξ hΞ U) =
        x * gammaIsoSemiringClass hc C Ξ hΞ (gammaPoint hc C Ξ hΞ) ∧
      gammaIsoSemiringClass hc C Ξ hΞ (GammaVolumeObjects.toAll C Ξ hΞ W) =
        x * gammaIsoSemiringClass hc C Ξ hΞ (gammaCone hc C Ξ hΞ) := by
  obtain ⟨U,hU⟩ := U
  obtain ⟨W,hW⟩ := W
  cases k with
  | succ k =>
    let H := admissibleHeadVolumeFactor 𝔇 U b.admissible
    have hH : VolumeObjectGamma H 𝔅 := hU.admissibleHead hc 𝔇 b.admissible
    let Hg : GammaRVObjects 𝔅 𝔖 (k+1) := ⟨H,(RVVolumeObject.Gamma.positive_iff H).mpr hH⟩
    refine ⟨gammaIsoSemiringClass hc C Ξ hΞ Hg,?_,?_⟩
    · rw [gamma_iso_semiring_class_mul]
      exact congrArg (DirectSum.of (GammaNamedRVIsoClasses hc C Ξ hΞ) ((k+1)+1))
        (gammaVolumeIsoClass_iso hc 𝔇 𝔅 (admissibleHeadPointVolumeIso 𝔇 U b.admissible)
          (gamma_admissible_head_point_iso hc 𝔇 hU b.admissible))
    · rw [gamma_iso_semiring_class_mul]
      obtain ⟨e,he⟩ := gamma_elementary_head_cone_iso hc 𝔇 b hU hW hb
      exact congrArg (DirectSum.of (GammaNamedRVIsoClasses hc C Ξ hΞ) ((k+1)+1))
        (gammaVolumeIsoClass_iso hc 𝔇 𝔅 e he)
  | zero =>
    let H := degreeOneHeadFactor 𝔇 U b.admissible
    have hH : H.Gamma 𝔅 := ZeroRVVolumeObject.Gamma.degreeOneHead hc 𝔇 hU b.admissible
    let Hg : GammaRVObjects 𝔅 𝔖 0 := ⟨H,(RVVolumeObject.Gamma.zero_iff H).mpr hH⟩
    have hP : VolumeObjectGamma (degreeOnePointVolumeObject (M := M) 𝔖) 𝔅 := VolumeObjectGamma.degreeOnePoint hc _
    have hCone : VolumeObjectGamma (degreeOneConeVolumeObject (M := M) 𝔖) 𝔅 := VolumeObjectGamma.degreeOneCone hc _
    have hHP := HK.RVVolumeObject.Gamma.product (n := 0) (m := 1) hc
      ((RVVolumeObject.Gamma.zero_iff H).mpr hH) ((RVVolumeObject.Gamma.positive_iff _).mpr hP)
    have hHC := HK.RVVolumeObject.Gamma.product (n := 0) (m := 1) hc
      ((RVVolumeObject.Gamma.zero_iff H).mpr hH) ((RVVolumeObject.Gamma.positive_iff _).mpr hCone)
    refine ⟨gammaIsoSemiringClass hc C Ξ hΞ Hg,?_,?_⟩
    · rw [gamma_iso_semiring_class_mul]
      exact congrArg (DirectSum.of (GammaNamedRVIsoClasses hc C Ξ hΞ) (0+1))
        (gammaVolumeIsoClass_iso hc 𝔇 𝔅
          ((degreeOneHeadPointVolumeIso 𝔇 U b.admissible).trans hc 𝔇
            ((productZeroPositiveIso hc 𝔇 H (degreeOnePointVolumeObject 𝔖)).symm hc 𝔇))
          ((gamma_degree_one_head_point_iso hc 𝔇 hU b.admissible).trans hc 𝔇 𝔅
            ((gamma_volume_iso_of_label_identity hc (productZeroPositiveIso hc 𝔇 H (degreeOnePointVolumeObject 𝔖))
              ((RVVolumeObject.Gamma.positive_iff _).mp hHP) rfl (fun _ => rfl)).symm hc 𝔇 𝔅)))
    · rw [gamma_iso_semiring_class_mul]
      obtain ⟨e,he⟩ := gamma_degree_one_head_cone_iso hc 𝔇 b hU hW hb
      exact congrArg (DirectSum.of (GammaNamedRVIsoClasses hc C Ξ hΞ) (0+1))
        (gammaVolumeIsoClass_iso hc 𝔇 𝔅
          (e.trans hc 𝔇 ((productZeroPositiveIso hc 𝔇 H (degreeOneConeVolumeObject 𝔖)).symm hc 𝔇))
          (he.trans hc 𝔇 𝔅
            ((gamma_volume_iso_of_label_identity hc (productZeroPositiveIso hc 𝔇 H (degreeOneConeVolumeObject 𝔖))
              ((RVVolumeObject.Gamma.positive_iff _).mp hHC) rfl (fun _ => rfl)).symm hc 𝔇 𝔅)))

section Basic
variable {R : Type*} [Semiring R] (f : GammaNamedRVIsoSemiring hc C Ξ hΞ →+* R)
variable (hBasic : f (gammaIsoSemiringClass hc C Ξ hΞ (gammaPoint hc C Ξ hΞ)) =
  f (gammaIsoSemiringClass hc C Ξ hΞ (gammaCone hc C Ξ hΞ)))
include hBasic

theorem gamma_elementary_image_eq_of_basic {k : ℕ} {U W : GammaVolumeObjects 𝔅 𝔖 k}
    (b : ElementaryBlowup U.val W.val) (hb : RVMapGamma b.packedChartMap 𝔅) :
    f (gammaIsoSemiringClass hc C Ξ hΞ (GammaVolumeObjects.toAll C Ξ hΞ U)) =
      f (gammaIsoSemiringClass hc C Ξ hΞ (GammaVolumeObjects.toAll C Ξ hΞ W)) := by
  obtain ⟨x,hU,hW⟩ := gamma_elementary_semiring_factorization hc C Ξ hΞ b hb
  rw [hU,hW,map_mul,map_mul,hBasic]

theorem gamma_blowup_image_eq_of_basic {k : ℕ} {U W : GammaVolumeObjects 𝔅 𝔖 k}
    (b : VolumeBlowup U.val W.val) (hb : b.GammaDefinable 𝔅) :
    f (gammaIsoSemiringClass hc C Ξ hΞ (GammaVolumeObjects.toAll C Ξ hΞ U)) =
      f (gammaIsoSemiringClass hc C Ξ hΞ (GammaVolumeObjects.toAll C Ξ hΞ W)) := by
  let L : GammaVolumeObjects 𝔅 𝔖 k := ⟨b.locus,hb.locus⟩
  let Q : GammaVolumeObjects 𝔅 𝔖 k := ⟨b.complement,hb.complement⟩
  let Bl : GammaVolumeObjects 𝔅 𝔖 k := ⟨b.blownLocus,hb.blown⟩
  rw [gamma_iso_semiring_class_iso hc C Ξ hΞ (V := L.coprod Q) b.sourceIso hb.source,
    gamma_iso_semiring_class_iso hc C Ξ hΞ (V := Bl.coprod Q) b.targetIso hb.target,
    gamma_iso_semiring_class_coprod,gamma_iso_semiring_class_coprod,map_add,map_add,
    gamma_elementary_image_eq_of_basic hc C Ξ hΞ f hBasic (U := L) (W := Bl) b.elementary hb.elementary]

theorem gamma_iterated_image_eq_of_basic {k d : ℕ} {U W : GammaVolumeObjects 𝔅 𝔖 k}
    (h : GammaIteratedVolumeBlowup 𝔅 𝔖 k d U W) :
    f (gammaIsoSemiringClass hc C Ξ hΞ (GammaVolumeObjects.toAll C Ξ hΞ U)) =
      f (gammaIsoSemiringClass hc C Ξ hΞ (GammaVolumeObjects.toAll C Ξ hΞ W)) := by
  induction h with
  | refl U => rfl
  | step b h ih =>
    obtain ⟨b,hb⟩ := b
    exact (gamma_blowup_image_eq_of_basic hc C Ξ hΞ f hBasic b hb).trans ih

theorem gamma_common_blowup_image_eq_of_basic {k : ℕ} {U W : GammaVolumeObjects 𝔅 𝔖 k}
    (h : GammaVolumeBlowupEquivalent 𝔅 𝔖 k U W) :
    f (gammaIsoSemiringClass hc C Ξ hΞ (GammaVolumeObjects.toAll C Ξ hΞ U)) =
      f (gammaIsoSemiringClass hc C Ξ hΞ (GammaVolumeObjects.toAll C Ξ hΞ W)) := by
  obtain ⟨a,b,U',W',hU,hW,e,he⟩ := h
  exact (gamma_iterated_image_eq_of_basic hc C Ξ hΞ f hBasic hU).trans
    ((congrArg f (gamma_iso_semiring_class_iso hc C Ξ hΞ e he)).trans
      (gamma_iterated_image_eq_of_basic hc C Ξ hΞ f hBasic hW).symm)

theorem gamma_rel_of_basic {n : ℕ} (U V : GammaRVObjects 𝔅 𝔖 n)
    (h : gammaNamedRVClass hc C Ξ hΞ U = gammaNamedRVClass hc C Ξ hΞ V) :
    f (gammaIsoSemiringClass hc C Ξ hΞ U) = f (gammaIsoSemiringClass hc C Ξ hΞ V) := by
  cases n with
  | zero => exact congrArg f (congrArg (DirectSum.of (GammaNamedRVIsoClasses hc C Ξ hΞ) 0) h)
  | succ k =>
    exact gamma_common_blowup_image_eq_of_basic hc C Ξ hΞ f hBasic
      (U := ⟨U.val,(RVVolumeObject.Gamma.positive_iff U.val).mp U.property⟩)
      (W := ⟨V.val,(RVVolumeObject.Gamma.positive_iff V.val).mp V.property⟩)
      ((gammaVolumeBlowupClass_eq_iff hc 𝔇 𝔅).mp h)

/-- The descended degree-`n` component. -/
def gammaBlowupUniversalComponent (n : ℕ) : GammaNamedRVClasses hc C Ξ hΞ n →+ R where
  toFun a := f (gammaIsoSemiringClass hc C Ξ hΞ (gammaNamedRVRep hc C Ξ hΞ a))
  map_zero' := by
    rw [gamma_rel_of_basic hc C Ξ hΞ f hBasic _ (gammaEmpty C Ξ hΞ n)
      ((gammaNamedRVRep_class hc C Ξ hΞ _).trans (gammaNamedRV_zero_eq hc C Ξ hΞ n))]
    change f (DirectSum.of _ n (gammaNamedRVIsoClass hc C Ξ hΞ (gammaEmpty C Ξ hΞ n))) = 0
    rw [← gammaNamedRVIso_zero_eq,map_zero,map_zero]
  map_add' a b := by
    induction a using gamma_named_class_induction hc C Ξ hΞ with
    | h U =>
      induction b using gamma_named_class_induction hc C Ξ hΞ with
      | h V =>
        rw [gammaNamedRV_add_eq]
        change f (gammaIsoSemiringClass hc C Ξ hΞ (gammaNamedRVRep hc C Ξ hΞ _)) =
          f (gammaIsoSemiringClass hc C Ξ hΞ (gammaNamedRVRep hc C Ξ hΞ _)) +
            f (gammaIsoSemiringClass hc C Ξ hΞ (gammaNamedRVRep hc C Ξ hΞ _))
        rw [gamma_rel_of_basic hc C Ξ hΞ f hBasic _ _ (gammaNamedRVRep_class hc C Ξ hΞ _),
          gamma_rel_of_basic hc C Ξ hΞ f hBasic _ _ (gammaNamedRVRep_class hc C Ξ hΞ (gammaNamedRVClass hc C Ξ hΞ U)),
          gamma_rel_of_basic hc C Ξ hΞ f hBasic _ _ (gammaNamedRVRep_class hc C Ξ hΞ (gammaNamedRVClass hc C Ξ hΞ V)),
          gammaIsoSemiringClass,gammaIsoSemiringClass,gammaIsoSemiringClass,gammaNamedRVIsoClass_coprod,
          map_add,map_add]

theorem gamma_blowup_universal_component_class {n : ℕ} (U : GammaRVObjects 𝔅 𝔖 n) :
    gammaBlowupUniversalComponent hc C Ξ hΞ f hBasic n (gammaNamedRVClass hc C Ξ hΞ U) =
      f (gammaIsoSemiringClass hc C Ξ hΞ U) :=
  gamma_rel_of_basic hc C Ξ hΞ f hBasic _ _ (gammaNamedRVRep_class hc C Ξ hΞ _)

/-- The ring map out of Gamma-named blowup classes induced by `f`. -/
def gammaBlowupUniversalDescend : GammaNamedRVSemiring hc C Ξ hΞ →+* R :=
  DirectSum.toSemiring (gammaBlowupUniversalComponent hc C Ξ hΞ f hBasic)
    (by
      change gammaBlowupUniversalComponent hc C Ξ hΞ f hBasic 0
        (gammaNamedRVClass hc C Ξ hΞ (gammaUnit hc C Ξ hΞ)) = 1
      rw [gamma_blowup_universal_component_class]
      exact f.map_one)
    (by
      intro i j a b
      induction a using gamma_named_class_induction hc C Ξ hΞ with
      | h U =>
        induction b using gamma_named_class_induction hc C Ξ hΞ with
        | h V =>
          change gammaBlowupUniversalComponent hc C Ξ hΞ f hBasic (i+j)
              (gammaNamedRVMul hc C Ξ hΞ (gammaNamedRVClass hc C Ξ hΞ U) (gammaNamedRVClass hc C Ξ hΞ V)) =
            gammaBlowupUniversalComponent hc C Ξ hΞ f hBasic i (gammaNamedRVClass hc C Ξ hΞ U) *
              gammaBlowupUniversalComponent hc C Ξ hΞ f hBasic j (gammaNamedRVClass hc C Ξ hΞ V)
          rw [gammaNamedRVMul_class,gamma_blowup_universal_component_class,
            gamma_blowup_universal_component_class,gamma_blowup_universal_component_class,← map_mul,
            gamma_iso_semiring_class_mul])

theorem gamma_blowup_universal_descend_projection :
    (gammaBlowupUniversalDescend hc C Ξ hΞ f hBasic).comp (gammaNamedGradedBlowupProjection hc C Ξ hΞ) = f := by
  apply RingHom.ext
  intro a
  induction a using DirectSum.induction_on with
  | zero => rw [map_zero,map_zero]
  | add a b ha hb => rw [map_add,map_add,ha,hb]
  | of n a =>
    induction a using gamma_named_iso_class_induction hc C Ξ hΞ with
    | h U =>
      change gammaBlowupUniversalDescend hc C Ξ hΞ f hBasic
        (gammaNamedGradedBlowupProjection hc C Ξ hΞ (DirectSum.of _ n (gammaNamedRVIsoClass hc C Ξ hΞ U))) = _
      rw [gammaNamedGradedBlowupProjection_of]
      change DirectSum.toSemiring _ _ _ (DirectSum.of _ n (gammaNamedBlowupProjectionOn hc C Ξ hΞ n
        (gammaNamedRVIsoClass hc C Ξ hΞ U))) = _
      rw [gammaNamedBlowupProjectionOn_class,DirectSum.toSemiring_of]
      exact gamma_blowup_universal_component_class hc C Ξ hΞ f hBasic U

end Basic

/-! ### The principal kernel -/

abbrev GammaNamedRawRVRing := SemiringGroupification (GammaNamedRVIsoSemiring hc C Ξ hΞ)

def gammaNamedRawBlowupRingProjection : GammaNamedRawRVRing hc C Ξ hΞ →+* GammaNamedRVRing hc C Ξ hΞ :=
  semiringGroupificationMap (gammaNamedGradedBlowupProjection hc C Ξ hΞ)

theorem gamma_named_raw_blowup_ring_projection_surjective :
    Function.Surjective (gammaNamedRawBlowupRingProjection hc C Ξ hΞ) :=
  semiringGroupificationMap_surjective _ (gammaNamedGradedBlowupProjection_surjective hc C Ξ hΞ)

def gammaNamedRawVolumeKernelIdeal : Ideal (GammaNamedRawRVRing hc C Ξ hΞ) :=
  RingHom.ker (gammaNamedRawBlowupRingProjection hc C Ξ hΞ)

def gammaNamedRawBasicDifference : GammaNamedRawRVRing hc C Ξ hΞ :=
  semiringGroupificationOf _ (gammaIsoSemiringClass hc C Ξ hΞ (gammaPoint hc C Ξ hΞ)) -
    semiringGroupificationOf _ (gammaIsoSemiringClass hc C Ξ hΞ (gammaCone hc C Ξ hΞ))

/-- The two-sided ideal generated by `[point] - [cone]`. -/
def gammaNamedBasicVolumeRelationIdeal : Ideal (GammaNamedRawRVRing hc C Ξ hΞ) :=
  (TwoSidedIdeal.span {gammaNamedRawBasicDifference hc C Ξ hΞ}).asIdeal

instance gammaNamedBasicVolumeRelationIdealTwoSided : (gammaNamedBasicVolumeRelationIdeal hc C Ξ hΞ).IsTwoSided :=
  inferInstanceAs (TwoSidedIdeal.span {gammaNamedRawBasicDifference hc C Ξ hΞ}).asIdeal.IsTwoSided

instance gammaNamedRawVolumeKernelIdealTwoSided : (gammaNamedRawVolumeKernelIdeal hc C Ξ hΞ).IsTwoSided :=
  inferInstanceAs (RingHom.ker (gammaNamedRawBlowupRingProjection hc C Ξ hΞ)).IsTwoSided

theorem gamma_basic_volume_relation_projection :
    gammaNamedGradedBlowupProjection hc C Ξ hΞ (gammaIsoSemiringClass hc C Ξ hΞ (gammaPoint hc C Ξ hΞ)) =
      gammaNamedGradedBlowupProjection hc C Ξ hΞ (gammaIsoSemiringClass hc C Ξ hΞ (gammaCone hc C Ξ hΞ)) := by
  rw [gammaIsoSemiringClass,gammaIsoSemiringClass,gammaNamedGradedBlowupProjection_of,
    gammaNamedGradedBlowupProjection_of]
  change DirectSum.of _ 1 (gammaNamedBlowupProjectionOn hc C Ξ hΞ 1 (gammaNamedRVIsoClass hc C Ξ hΞ _)) =
    DirectSum.of _ 1 (gammaNamedBlowupProjectionOn hc C Ξ hΞ 1 (gammaNamedRVIsoClass hc C Ξ hΞ _))
  rw [gammaNamedBlowupProjectionOn_class,gammaNamedBlowupProjectionOn_class]
  exact congrArg (DirectSum.of (GammaNamedRVClasses hc C Ξ hΞ) 1)
    ((gammaVolumeBlowupClass_eq_iff hc 𝔇 𝔅).mpr (gamma_degree_one_basic_volume_relation hc 𝔇))

theorem gamma_raw_basic_difference_mem_kernel :
    gammaNamedRawBasicDifference hc C Ξ hΞ ∈ gammaNamedRawVolumeKernelIdeal hc C Ξ hΞ := by
  apply RingHom.mem_ker.mpr
  change gammaNamedRawBlowupRingProjection hc C Ξ hΞ
    (semiringGroupificationOf _ (gammaIsoSemiringClass hc C Ξ hΞ (gammaPoint hc C Ξ hΞ)) -
      semiringGroupificationOf _ (gammaIsoSemiringClass hc C Ξ hΞ (gammaCone hc C Ξ hΞ))) = 0
  rw [map_sub]
  change semiringGroupificationMap (gammaNamedGradedBlowupProjection hc C Ξ hΞ) _ -
    semiringGroupificationMap (gammaNamedGradedBlowupProjection hc C Ξ hΞ) _ = 0
  rw [semiringGroupificationMap_of,semiringGroupificationMap_of,gamma_basic_volume_relation_projection]
  exact sub_self _

/-- **Gamma-named principal kernel.** -/
theorem gamma_named_raw_volume_kernel_principal :
    gammaNamedRawVolumeKernelIdeal hc C Ξ hΞ = gammaNamedBasicVolumeRelationIdeal hc C Ξ hΞ := by
  have hle : gammaNamedBasicVolumeRelationIdeal hc C Ξ hΞ ≤ gammaNamedRawVolumeKernelIdeal hc C Ξ hΞ := by
    have h : TwoSidedIdeal.span {gammaNamedRawBasicDifference hc C Ξ hΞ} ≤
        (gammaNamedRawVolumeKernelIdeal hc C Ξ hΞ).toTwoSided := by
      apply TwoSidedIdeal.span_le.mpr
      intro x hx
      apply Ideal.mem_toTwoSided.mpr
      exact (Set.mem_singleton_iff.mp hx) ▸ gamma_raw_basic_difference_mem_kernel hc C Ξ hΞ
    intro x hx
    exact Ideal.mem_toTwoSided.mp (h hx)
  apply le_antisymm _ hle
  let I := gammaNamedBasicVolumeRelationIdeal hc C Ξ hΞ
  let q := Ideal.Quotient.mk I
  let f := q.comp (semiringGroupificationOf (GammaNamedRVIsoSemiring hc C Ξ hΞ))
  have hBasic : f (gammaIsoSemiringClass hc C Ξ hΞ (gammaPoint hc C Ξ hΞ)) =
      f (gammaIsoSemiringClass hc C Ξ hΞ (gammaCone hc C Ξ hΞ)) := by
    apply sub_eq_zero.mp
    change q (semiringGroupificationOf _ (gammaIsoSemiringClass hc C Ξ hΞ (gammaPoint hc C Ξ hΞ))) -
      q (semiringGroupificationOf _ (gammaIsoSemiringClass hc C Ξ hΞ (gammaCone hc C Ξ hΞ))) = 0
    rw [← map_sub]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (TwoSidedIdeal.subset_span (Set.mem_singleton _))
  let g := semiringGroupificationLift (gammaBlowupUniversalDescend hc C Ξ hΞ f hBasic)
  have hg : g.comp (gammaNamedRawBlowupRingProjection hc C Ξ hΞ) = q := by
    apply semiringGroupification_hom_ext
    intro a
    change g (semiringGroupificationMap (gammaNamedGradedBlowupProjection hc C Ξ hΞ)
      (semiringGroupificationOf _ a)) = f a
    rw [semiringGroupificationMap_of]
    change semiringGroupificationLift _ (semiringGroupificationOf _ _) = f a
    rw [semiringGroupificationLift_of]
    exact RingHom.congr_fun (gamma_blowup_universal_descend_projection hc C Ξ hΞ f hBasic) a
  intro x hx
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  have he := RingHom.congr_fun hg x
  rw [RingHom.comp_apply,RingHom.mem_ker.mp hx,map_zero] at he
  exact he.symm

def gammaNamedPrincipalKernelQuotientEquiv :
    (GammaNamedRawRVRing hc C Ξ hΞ ⧸ gammaNamedBasicVolumeRelationIdeal hc C Ξ hΞ) ≃+* GammaNamedRVRing hc C Ξ hΞ :=
  (Ideal.quotEquivOfEq (gamma_named_raw_volume_kernel_principal hc C Ξ hΞ).symm).trans
    (RingHom.quotientKerEquivOfSurjective (gamma_named_raw_blowup_ring_projection_surjective hc C Ξ hΞ))

