module

public import Integration7.RawPositiveKernelPresentation
public import Integration7.RawElementaryKernelDifferences
public import Integration7.VolumeBlowupUniversalProperty
public import Mathlib.RingTheory.TwoSidedIdeal.Operations

set_option backward.privateInPublic true
set_option backward.proofsInPublic true
@[expose] public section

/-! The raw kernel is generated by actual equal-degree geometric
common-blowup differences. This identifies the complete relation ideal;
reducing these generators to the single basic relation is separate. -/
noncomputable section
set_option backward.isDefEq.respectTransparency false
open FirstOrder FirstOrder.Language
open SpecialTransformations.Milestone0 SpecialTransformations.Milestone0.LRV
open SpecialTransformations.Section3
namespace IntegrationInACVF.Section7
variable {M : Type} [LRV.Structure M] [M ⊨ Axioms.ACVF]
variable (hc : CanonicalStructure.IsCanonical (M := M)) (C : BaseContext M)

def rawHomogeneousVolumeDifferences : Set (RawRVVolumeRing hc C) :=
  {x | ∃ (n : ℕ) (U V : RVVolumeObject (M := M) (C.base : Set M) n),
    MuIsp (C.base : Set M) n U V ∧ x=rawVolumeObjectClass hc C U-rawVolumeObjectClass hc C V}

theorem raw_common_blowup_difference_mem_kernel {n : ℕ}
    (U V : RVVolumeObject (M := M) (C.base : Set M) n)
    (h : MuIsp (C.base : Set M) n U V) :
    rawVolumeObjectClass hc C U-rawVolumeObjectClass hc C V ∈ rawVolumeKernelIdeal hc C := by
  apply (raw_volume_kernel_mem_iff_positive_pair hc C _).mpr
  refine ⟨volumeIsoSemiringClass hc C U,volumeIsoSemiringClass hc C V,?_,rfl⟩
  rw [volumeIsoSemiringClass,volumeIsoSemiringClass,rvVolumeGradedBlowupProjection_of,
    rvVolumeGradedBlowupProjection_of]
  exact congrArg (DirectSum.of (RVVolumeBlowupClasses hc C) n) (Quotient.sound h)

def rawHomogeneousVolumeRelationIdeal : Ideal (RawRVVolumeRing hc C) :=
  (TwoSidedIdeal.span (rawHomogeneousVolumeDifferences hc C)).asIdeal

instance rawHomogeneousVolumeRelationIdealTwoSided :
    (rawHomogeneousVolumeRelationIdeal hc C).IsTwoSided := inferInstanceAs
      (TwoSidedIdeal.span (rawHomogeneousVolumeDifferences hc C)).asIdeal.IsTwoSided

theorem raw_homogeneous_relation_ideal_le_kernel :
    rawHomogeneousVolumeRelationIdeal hc C ≤ rawVolumeKernelIdeal hc C := by
  have h : TwoSidedIdeal.span (rawHomogeneousVolumeDifferences hc C) ≤
      (rawVolumeKernelIdeal hc C).toTwoSided := by
    apply TwoSidedIdeal.span_le.mpr
    rintro x ⟨n,U,V,hUV,rfl⟩
    exact Ideal.mem_toTwoSided.mpr (raw_common_blowup_difference_mem_kernel hc C U V hUV)
  intro x hx
  simpa only [Ideal.mem_toTwoSided] using h hx

theorem raw_volume_kernel_eq_homogeneous_relations :
    rawVolumeKernelIdeal hc C=rawHomogeneousVolumeRelationIdeal hc C := by
  apply le_antisymm _ (raw_homogeneous_relation_ideal_le_kernel hc C)
  let I := rawHomogeneousVolumeRelationIdeal hc C
  let q := Ideal.Quotient.mk I
  let f := q.comp (semiringGroupificationOf (RVVolumeIsoSemiring hc C))
  have hrel : ∀ n (U V : RVVolumeObject (M := M) (C.base : Set M) n),
      MuIsp (C.base : Set M) n U V →
      f (volumeIsoSemiringClass hc C U)=f (volumeIsoSemiringClass hc C V) := by
    intro n U V hUV
    apply sub_eq_zero.mp
    change q (rawVolumeObjectClass hc C U)-q (rawVolumeObjectClass hc C V)=0
    rw [←map_sub]
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    exact TwoSidedIdeal.subset_span ⟨n,U,V,hUV,rfl⟩
  let g := semiringGroupificationLift (volumeBlowupUniversalDescend hc C f hrel)
  have hg : g.comp (rawVolumeBlowupRingProjection hc C)=q := by
    apply semiringGroupification_hom_ext
    intro a
    change g (semiringGroupificationMap (rvVolumeGradedBlowupProjection hc C)
      (semiringGroupificationOf _ a))=f a
    rw [semiringGroupificationMap_of]
    change semiringGroupificationLift _ (semiringGroupificationOf _ _)=f a
    rw [semiringGroupificationLift_of]
    exact RingHom.congr_fun (volume_blowup_universal_descend_projection hc C f hrel) a
  intro x hx
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  have he := RingHom.congr_fun hg x
  rw [RingHom.comp_apply,RingHom.mem_ker.mp hx,map_zero] at he
  exact he.symm
end IntegrationInACVF.Section7
