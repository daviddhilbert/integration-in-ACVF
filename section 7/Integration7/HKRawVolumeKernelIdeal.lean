import Integration7.HKGradedBlowupProjection
import Integration7.SemiringGroupificationDifferences

import Mathlib.RingTheory.Ideal.Quotient.Operations

/-! The actual raw kernel ideal and its canonical integration quotient.
The ideal is defined by the proved blowup projection. Identification of
this ideal with the ideal generated by point minus cone is separate. -/
noncomputable section
set_option backward.isDefEq.respectTransparency false
open FirstOrder FirstOrder.Language
open SpecialTransformations.Milestone0 SpecialTransformations.Milestone0.LRV
open SpecialTransformations.Section3 SpecialTransformations.Section3.GammaParameters
namespace IntegrationInACVF.Section7.HK
variable {M : Type} [LRV.Structure M] [M ⊨ Axioms.ACVF]
variable (hc : CanonicalStructure.IsCanonical (M := M)) (C : BaseContext M)

abbrev RawRVVolumeRing := SemiringGroupification (RVVolumeIsoSemiring hc C)
abbrev RVVolumeBlowupRing := SemiringGroupification (RVVolumeBlowupSemiring hc C)

def rawVolumeBlowupRingProjection : RawRVVolumeRing hc C →+* RVVolumeBlowupRing hc C :=
  semiringGroupificationMap (rvVolumeGradedBlowupProjection hc C)

theorem raw_volume_blowup_ring_projection_surjective : Function.Surjective (rawVolumeBlowupRingProjection hc C) :=
  semiringGroupificationMap_surjective _ (rvVolumeGradedBlowupProjection_surjective hc C)

def rawVolumeKernelIdeal : Ideal (RawRVVolumeRing hc C) := RingHom.ker (rawVolumeBlowupRingProjection hc C)

instance rawVolumeKernelIdealTwoSided : (rawVolumeKernelIdeal hc C).IsTwoSided :=
  inferInstanceAs (RingHom.ker (rawVolumeBlowupRingProjection hc C)).IsTwoSided

def rawVolumeKernelIdealQuotientEquiv :
    (RawRVVolumeRing hc C ⧸ rawVolumeKernelIdeal hc C) ≃+* RVVolumeBlowupRing hc C :=
  RingHom.quotientKerEquivOfSurjective (raw_volume_blowup_ring_projection_surjective hc C)

theorem raw_volume_kernel_quotient_generator (a : RVVolumeIsoSemiring hc C) :
    rawVolumeKernelIdealQuotientEquiv hc C
      (Ideal.Quotient.mk (rawVolumeKernelIdeal hc C) (semiringGroupificationOf _ a)) =
    semiringGroupificationOf _ (rvVolumeGradedBlowupProjection hc C a) :=
  semiringGroupificationMap_of _ _

end IntegrationInACVF.Section7.HK
