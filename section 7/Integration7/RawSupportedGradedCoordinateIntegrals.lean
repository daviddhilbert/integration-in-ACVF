module

public import Integration7.RawHomogeneousCoordinateSupports
public import Integration7.RawNonemptyCoordinateFubini

set_option backward.privateInPublic true
set_option backward.proofsInPublic true
@[expose] public section

/-! The raw supported module generated by actual supported homogeneous
families, including ordinary degree zero. Proper coordinate integrals
preserve the literal projected support, and their raw totals satisfy
Fubini. No normalized coefficient relation is used. -/
noncomputable section
set_option backward.isDefEq.respectTransparency false
open FirstOrder FirstOrder.Language
open SpecialTransformations.Milestone0 SpecialTransformations.Milestone0.LRV
open SpecialTransformations.Section3 SpecialTransformations.Section3.GammaParameters
open SpecialTransformations.Section4 SpecialTransformations.DefinableGeometry
open IntegrationInACVF.Section6
open scoped DirectSum
namespace IntegrationInACVF.Section7
variable {M : Type} [LRV.Structure M] [M ⊨ Axioms.ACVF] {n p : ℕ}
variable (hc : CanonicalStructure.IsCanonical (M := M)) (C : BaseContext M)

def rawSupportedVolumeGenerators
    (X : DefSet (rawVFSpace (M := M) (n+1)) (C.base : Set M)) : Set (GradedAEVolumeFunction hc C n) :=
  {g | ∃ (j : ℕ) (f : AEVolumeFunctionComponent hc C n j),
    HasRawVolumeComponentSupport hc C X j f ∧ DirectSum.of (AEVolumeFunctionComponent hc C n) j f=g}

def rawSupportedVolumeSubmodule
    (X : DefSet (rawVFSpace (M := M) (n+1)) (C.base : Set M)) :
    Submodule (RVVolumeBlowupSemiring hc C) (GradedAEVolumeFunction hc C n) :=
  Submodule.span _ (rawSupportedVolumeGenerators hc C X)

theorem raw_supported_volume_generator_mem
    (X : DefSet (rawVFSpace (M := M) (n+1)) (C.base : Set M)) (j : ℕ)
    (f : AEVolumeFunctionComponent hc C n j) (hf : HasRawVolumeComponentSupport hc C X j f) :
    DirectSum.of (AEVolumeFunctionComponent hc C n) j f ∈ rawSupportedVolumeSubmodule hc C X :=
  Submodule.subset_span ⟨j,f,hf,rfl⟩

theorem raw_supported_positive_correction_mem
    (X : DefSet (rawVFSpace (M := M) (n+1)) (C.base : Set M)) (j : ℕ) (hj : 0<j)
    (f : AEVolumeFunctionComponent hc C n j) (hf : HasRawVolumeComponentSupport hc C X j f)
    (c : CanonicalRV.RVSort M) (hcS : c.val ∈ C.base) (hc0 : c≠0) :
    positiveGradedAEVolumeInclusion hc C n
      (positiveGradedAEVolumeDensityRescale hc C c hcS hc0 n
        (positiveGradedAEVolumePart hc C n (DirectSum.of (AEVolumeFunctionComponent hc C n) j f))) ∈
      rawSupportedVolumeSubmodule hc C X := by
  cases j with
  | zero => omega
  | succ k =>
    rw [positive_graded_ae_volume_part_of,positive_graded_density_rescale_of,positive_graded_ae_volume_inclusion_of]
    exact raw_supported_volume_generator_mem hc C X (k+1) _
      (raw_positive_rescale_preserves_support hc C X f hf c hcS hc0)

variable (Ξ : Set (Values.Gamma (M := M))) (hΞ : Cardinal.mk Ξ < C.κ)
variable (hGenerated : VFGammaGeneratedBase (⟨(C.base : Set M),Ξ⟩ : Base (M := M)))
variable (hNames : commonRealNames (⟨(C.base : Set M),Ξ⟩ : Base (M := M)) ⊆ (C.base : Set M))
variable (γ : Values.Gamma (M := M)) (hγ : γ ∈ Ξ) (hγ1 : 1 < γ)

def rawStrictVolumeCoordinateIntegral (E : VFCoordinateProjection (n+1) (p+1)) (hE : 0<E.discarded) :
    GradedAEVolumeFunction hc C n →ₗ[RVVolumeBlowupSemiring hc C] GradedAEVolumeFunction hc C p :=
  (positiveGradedAEVolumeInclusion hc C p).comp
    (strictGradedAEVolumeSignedCoordinatePushforward hc C Ξ hΞ hGenerated hNames γ hγ hγ1 E hE)

theorem raw_strict_volume_coordinate_preserves_support
    (X : DefSet (rawVFSpace (M := M) (n+1)) (C.base : Set M)) (E : VFCoordinateProjection (n+1) (p+1))
    (hE : 0<E.discarded) (f : GradedAEVolumeFunction hc C n) (hf : f ∈ rawSupportedVolumeSubmodule hc C X) :
    rawStrictVolumeCoordinateIntegral hc C Ξ hΞ hGenerated hNames γ hγ hγ1 E hE f ∈
      rawSupportedVolumeSubmodule hc C (pureVFCoordinateImage X E.retainedIndex) := by
  induction hf using Submodule.span_induction with
  | mem g hg =>
    obtain ⟨j,f,hf,rfl⟩ := hg
    change positiveGradedAEVolumeInclusion hc C p
      (positiveGradedAEVolumeDensityRescale hc C _ _ _ p
        (positiveGradedAEVolumePart hc C p
          (gradedAEVolumeCoordinatePushforward hc C Ξ hΞ hGenerated hNames γ hγ hγ1 E (DirectSum.of _ j f)))) ∈ _
    rw [graded_ae_volume_coordinate_pushforward_of]
    exact raw_supported_positive_correction_mem hc C _ _ (by rw [append_volume_degree_eq]; omega) _
      (raw_volume_component_coordinate_preserves_support hc C Ξ hΞ hGenerated hNames γ hγ hγ1 X E j f hf) _ _ _
  | zero => simpa only [map_zero] using (rawSupportedVolumeSubmodule hc C _).zero_mem
  | add f g hf hg ihf ihg =>
    rw [map_add]
    exact (rawSupportedVolumeSubmodule hc C _).add_mem ihf ihg
  | smul r f hf ih =>
    rw [map_smul]
    exact (rawSupportedVolumeSubmodule hc C _).smul_mem r ih

def rawSupportedStrictCoordinateIntegral
    (X : DefSet (rawVFSpace (M := M) (n+1)) (C.base : Set M)) (E : VFCoordinateProjection (n+1) (p+1))
    (hE : 0<E.discarded) :
    rawSupportedVolumeSubmodule hc C X →ₗ[RVVolumeBlowupSemiring hc C]
      rawSupportedVolumeSubmodule hc C (pureVFCoordinateImage X E.retainedIndex) :=
  LinearMap.codRestrict _
    ((rawStrictVolumeCoordinateIntegral hc C Ξ hΞ hGenerated hNames γ hγ hγ1 E hE).comp
      (rawSupportedVolumeSubmodule hc C X).subtype)
    (fun f => raw_strict_volume_coordinate_preserves_support hc C Ξ hΞ hGenerated hNames γ hγ hγ1 X E hE f.val f.property)

def rawSupportedGradedVolumeIntegral
    (X : DefSet (rawVFSpace (M := M) (n+1)) (C.base : Set M)) :
    rawSupportedVolumeSubmodule hc C X →ₗ[RVVolumeBlowupSemiring hc C] RVVolumeBlowupSemiring hc C :=
  (gradedAEVolumeIntegralLinearMap hc C Ξ hΞ hGenerated hNames γ hγ hγ1 n).comp
    (rawSupportedVolumeSubmodule hc C X).subtype

theorem raw_supported_strict_coordinate_total_fubini
    (X : DefSet (rawVFSpace (M := M) (n+1)) (C.base : Set M)) (E : VFCoordinateProjection (n+1) (p+1))
    (hE : 0<E.discarded) :
    (rawSupportedGradedVolumeIntegral hc C Ξ hΞ hGenerated hNames γ hγ hγ1 (pureVFCoordinateImage X E.retainedIndex)).comp
      (rawSupportedStrictCoordinateIntegral hc C Ξ hΞ hGenerated hNames γ hγ hγ1 X E hE) =
      rawSupportedGradedVolumeIntegral hc C Ξ hΞ hGenerated hNames γ hγ hγ1 X := by
  apply LinearMap.ext
  intro f
  exact strict_graded_signed_coordinate_integral_eq_total hc C Ξ hΞ hGenerated hNames γ hγ hγ1 E hE f.val
end IntegrationInACVF.Section7
