module

public import Integration7.HeadFibreRawVolumePresentation
public import Section8.GenericOutputBall

set_option backward.privateInPublic true
set_option backward.proofsInPublic true
@[expose] public section

/-! Full VF independence makes the active head independent over the
actual coefficient field generated by the frozen remaining coordinates. -/
noncomputable section
set_option backward.isDefEq.respectTransparency false
open Classical FirstOrder FirstOrder.Language
open SpecialTransformations.Milestone0 SpecialTransformations.Milestone0.LRV
open SpecialTransformations.Milestone0.Transfer
open SpecialTransformations.Section3 SpecialTransformations.Section4 SpecialTransformations.Section8
open SpecialTransformations.Section5
open IntegrationInACVF.Section5 IntegrationInACVF.Section6

namespace IntegrationInACVF.Section7

theorem independent_head_over_tail_field {K : Type} [Field K] {n : ℕ}
    (E : Subfield K) (x : Fin (n+1) → K) (hx : AlgebraicIndependent E x) :
    AlgebraicIndependent (tupleField E (fun j : Fin n => x j.succ)) (fun _ : Fin 1 => x 0) := by
  let e : Fin 1 ⊕ Fin n → Fin (n+1) := Sum.elim (fun _ => 0) Fin.succ
  have he : Function.Injective e := by
    rintro (i|i) (j|j) h
    · exact congrArg Sum.inl (Subsingleton.elim _ _)
    · exact False.elim ((Fin.succ_ne_zero j) h.symm)
    · exact False.elim ((Fin.succ_ne_zero i) h)
    · exact congrArg Sum.inr (Fin.succ_injective n h)
  have hSum : AlgebraicIndependent E (Sum.elim (fun _ : Fin 1 => x 0) (fun j : Fin n => x j.succ)) := by
    convert hx.comp e he using 1
    funext i
    cases i <;> rfl
  rw [tupleField_eq_adjoin]
  exact IntermediateField.algebraicIndependent_adjoin_iff.mpr
    (AlgebraicIndependent.sumElim_iff.mp hSum).2

variable {M : Type} [LRV.Structure M] [M ⊨ Axioms.ACVF] {S : Set M} {n : ℕ}

theorem independent_head_over_coordinate_fibre_base (x : Fin (n+1) → VF (M := M))
    (hx : AlgebraicIndependent (vfParameterField S) x) :
    AlgebraicIndependent
      (vfParameterField (coordinateFibreBase S 0 (headFrozenTuple (fun j : Fin n => x j.succ))))
      (fun _ : Fin 1 => x 0) := by
  have hField : vfParameterField (coordinateFibreBase S 0 (headFrozenTuple (fun j : Fin n => x j.succ))) =
      tupleField (vfParameterField S) (fun j : Fin n => x j.succ) := by
    rw [head_coordinate_fibre_base]
    exact vfParameterField_union_tuple S _
  exact Eq.mpr (congrArg (fun E : Subfield (VFType (M := M)) =>
    AlgebraicIndependent E (fun _ : Fin 1 => x 0)) hField)
      (independent_head_over_tail_field (vfParameterField S) x hx)

end IntegrationInACVF.Section7
