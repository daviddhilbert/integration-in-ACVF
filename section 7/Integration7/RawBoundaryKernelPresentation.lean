import Integration7.RawHomogeneousKernelRelations
import Integration7.LocalizedBasicVolumeGeneration

/-! The exact raw kernel is generated by the basic relation together
with the actual elementary degree-one relations. Higher-degree source
relations need no additional generators. This retains, rather than
assumes away, the unresolved degree-one principal-ideal question. -/
noncomputable section
set_option backward.isDefEq.respectTransparency false
open FirstOrder FirstOrder.Language
open SpecialTransformations.Milestone0 SpecialTransformations.Milestone0.LRV
open SpecialTransformations.Section3 SpecialTransformations.Section3.GammaParameters
namespace IntegrationInACVF.Section7
variable {M : Type} [LRV.Structure M] [M ⊨ Axioms.ACVF]
variable (hc : CanonicalStructure.IsCanonical (M := M)) (C : BaseContext M)

def rawDegreeOneElementaryDifferences : Set (RawRVVolumeRing hc C) :=
  {x | ∃ (U W : PositiveRVVolumeObject (M := M) (C.base : Set M) 0),
    Nonempty (ElementaryBlowup U W) ∧ x=rawVolumeObjectClass hc C (n := 1) U-rawVolumeObjectClass hc C (n := 1) W}

def rawBoundaryVolumeGenerators : Set (RawRVVolumeRing hc C) :=
  {rawBasicVolumeDifference hc C} ∪ rawDegreeOneElementaryDifferences hc C

def rawBoundaryVolumeRelationIdeal : Ideal (RawRVVolumeRing hc C) :=
  (TwoSidedIdeal.span (rawBoundaryVolumeGenerators hc C)).asIdeal

instance rawBoundaryVolumeRelationIdealTwoSided : (rawBoundaryVolumeRelationIdeal hc C).IsTwoSided :=
  inferInstanceAs (TwoSidedIdeal.span (rawBoundaryVolumeGenerators hc C)).asIdeal.IsTwoSided

theorem raw_boundary_relation_ideal_le_kernel :
    rawBoundaryVolumeRelationIdeal hc C ≤ rawVolumeKernelIdeal hc C := by
  have h : TwoSidedIdeal.span (rawBoundaryVolumeGenerators hc C) ≤ (rawVolumeKernelIdeal hc C).toTwoSided := by
    apply TwoSidedIdeal.span_le.mpr
    intro x hx
    apply Ideal.mem_toTwoSided.mpr
    rcases hx with hx | ⟨U,W,⟨b⟩,rfl⟩
    · exact (Set.mem_singleton_iff.mp hx) ▸ raw_basic_volume_difference_mem_kernel hc C
    · exact raw_common_blowup_difference_mem_kernel (n := 1) hc C U W
        (VolumeBlowupEquivalent.of_blowup hc C (VolumeBlowup.ofElementary hc C b))
  intro x hx
  exact Ideal.mem_toTwoSided.mp (h hx)

theorem raw_volume_kernel_eq_boundary_relations :
    rawVolumeKernelIdeal hc C=rawBoundaryVolumeRelationIdeal hc C := by
  apply le_antisymm _ (raw_boundary_relation_ideal_le_kernel hc C)
  let I := rawBoundaryVolumeRelationIdeal hc C
  let q := Ideal.Quotient.mk I
  let f := q.comp (semiringGroupificationOf (RVVolumeIsoSemiring hc C))
  have hBasic : Ideal.span {rawBasicVolumeDifference hc C} ≤ I := by
    apply Ideal.span_le.mpr
    intro x hx
    exact TwoSidedIdeal.subset_span (Or.inl hx)
  have hElm : ∀ {k : ℕ} {U W : PositiveRVVolumeObject (M := M) (C.base : Set M) k},
      ElementaryBlowup U W → f (volumeIsoSemiringClass hc C (n := k+1) U)=f (volumeIsoSemiringClass hc C (n := k+1) W) := by
    intro k U W b
    apply sub_eq_zero.mp
    change q (rawVolumeObjectClass hc C (n := k+1) U)-q (rawVolumeObjectClass hc C (n := k+1) W)=0
    rw [← map_sub]
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    cases k with
    | zero => exact TwoSidedIdeal.subset_span (Or.inr ⟨U,W,⟨b⟩,rfl⟩)
    | succ k => exact hBasic (raw_elementary_positive_difference_mem_basic_span hc C b)
  have hBlow : ∀ {k : ℕ} {U W : PositiveRVVolumeObject (M := M) (C.base : Set M) k},
      VolumeBlowup U W → f (volumeIsoSemiringClass hc C (n := k+1) U)=f (volumeIsoSemiringClass hc C (n := k+1) W) := by
    intro k U W b
    rw [volume_iso_semiring_class_iso hc C b.sourceIso,volume_iso_semiring_class_iso hc C b.targetIso,
      volume_iso_semiring_class_coprod,volume_iso_semiring_class_coprod,map_add,map_add,hElm b.elementary]
  have hIter : ∀ {k d : ℕ} {U W : PositiveRVVolumeObject (M := M) (C.base : Set M) k},
      IteratedVolumeBlowup d U W → f (volumeIsoSemiringClass hc C (n := k+1) U)=f (volumeIsoSemiringClass hc C (n := k+1) W) := by
    intro k d U W b
    induction b with
    | refl U => rfl
    | step b h ih => exact (hBlow b.some).trans ih
  have hRel : ∀ (n : ℕ) (U V : RVVolumeObject (M := M) (C.base : Set M) n),
      MuIsp (C.base : Set M) n U V → f (volumeIsoSemiringClass hc C U)=f (volumeIsoSemiringClass hc C V) := by
    intro n U V hUV
    cases n with
    | zero => exact congrArg f (congrArg (DirectSum.of (RVVolumeIsoClasses hc C) 0) (Quotient.sound hUV))
    | succ k =>
      obtain ⟨a,b,U',V',hU,hV,⟨e⟩⟩ := hUV
      exact (hIter hU).trans ((congrArg f (volume_iso_semiring_class_iso hc C e)).trans (hIter hV).symm)
  have hSpan : TwoSidedIdeal.span (rawHomogeneousVolumeDifferences hc C) ≤
      TwoSidedIdeal.span (rawBoundaryVolumeGenerators hc C) := by
    apply TwoSidedIdeal.span_le.mpr
    rintro x ⟨n,U,V,hUV,rfl⟩
    have hzero : q (rawVolumeObjectClass hc C (n := n) U-rawVolumeObjectClass hc C (n := n) V)=0 := by
      rw [map_sub]
      exact sub_eq_zero.mpr (hRel n U V hUV)
    exact Ideal.Quotient.eq_zero_iff_mem.mp hzero
  rw [raw_volume_kernel_eq_homogeneous_relations]
  exact hSpan

def rawBoundaryVolumeQuotientEquiv :
    (RawRVVolumeRing hc C ⧸ rawBoundaryVolumeRelationIdeal hc C) ≃+* RVVolumeBlowupRing hc C :=
  (Ideal.quotEquivOfEq (raw_volume_kernel_eq_boundary_relations hc C).symm).trans
    (rawVolumeKernelIdealQuotientEquiv hc C)

theorem raw_principal_kernel_iff_degree_one :
    rawVolumeKernelIdeal hc C=(TwoSidedIdeal.span {rawBasicVolumeDifference hc C}).asIdeal ↔
      rawDegreeOneElementaryDifferences hc C ⊆ (TwoSidedIdeal.span {rawBasicVolumeDifference hc C}).asIdeal := by
  constructor
  · intro h x hx
    rw [← h,raw_volume_kernel_eq_boundary_relations]
    exact TwoSidedIdeal.subset_span (Or.inr hx)
  · intro h
    rw [raw_volume_kernel_eq_boundary_relations]
    apply le_antisymm
    · have hSpan : TwoSidedIdeal.span (rawBoundaryVolumeGenerators hc C) ≤
          TwoSidedIdeal.span {rawBasicVolumeDifference hc C} := by
        apply TwoSidedIdeal.span_le.mpr
        rintro x (hx | hx)
        · exact TwoSidedIdeal.subset_span hx
        · exact h hx
      exact hSpan
    · have hSpan : TwoSidedIdeal.span {rawBasicVolumeDifference hc C} ≤
          TwoSidedIdeal.span (rawBoundaryVolumeGenerators hc C) := by
        apply TwoSidedIdeal.span_le.mpr
        intro x hx
        exact TwoSidedIdeal.subset_span (Or.inl hx)
      exact hSpan

variable (Ξ : Set (Values.Gamma (M := M))) (hΞ : Cardinal.mk Ξ < C.κ)
variable (hGenerated : VFGammaGeneratedBase (⟨(C.base : Set M),Ξ⟩ : Base (M := M)))
variable (hNames : commonRealNames (⟨(C.base : Set M),Ξ⟩ : Base (M := M)) ⊆ (C.base : Set M))
variable (γ : Values.Gamma (M := M)) (hγ : γ ∈ Ξ) (hγ1 : 1 < γ)

def volumeIntegrationBoundaryKernelEquiv :
    letI := vfVolumeIsoClassesAddCommMonoid hc C Ξ hΞ hGenerated hNames γ hγ hγ1
    letI := vfVolumeGradedSemiringStructure hc C Ξ hΞ hGenerated hNames γ hγ hγ1
    VFVolumeRing hc C Ξ hΞ hGenerated hNames γ hγ hγ1 ≃+*
      (RawRVVolumeRing hc C ⧸ rawBoundaryVolumeRelationIdeal hc C) := by
  letI := vfVolumeIsoClassesAddCommMonoid hc C Ξ hΞ hGenerated hNames γ hγ hγ1
  letI := vfVolumeGradedSemiringStructure hc C Ξ hΞ hGenerated hNames γ hγ hγ1
  exact (volumeIntegrationRingEquiv hc C Ξ hΞ hGenerated hNames γ hγ hγ1).trans
    (rawBoundaryVolumeQuotientEquiv hc C).symm
end IntegrationInACVF.Section7
