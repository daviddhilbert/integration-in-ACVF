module

public import Integration7.HKBasicGeneration
public import Integration7.HKBlowupUniversalProperty
public import Integration7.HKRawVolumeKernelIdeal
public import Mathlib.RingTheory.TwoSidedIdeal.Operations

@[expose] public section

/-! The kernel of the actual corrected graded blowup ring projection is
generated by point minus cone. No degree-one relation, cancellation of a
point, localization, or principal-ideal assertion is a proof input. -/
noncomputable section
set_option backward.isDefEq.respectTransparency false
open FirstOrder FirstOrder.Language
open SpecialTransformations.Milestone0 SpecialTransformations.Milestone0.LRV
open SpecialTransformations.Section3

namespace IntegrationInACVF.Section7.HK
variable {M : Type} [LRV.Structure M] [M ⊨ Axioms.ACVF]
variable (hc : CanonicalStructure.IsCanonical (M := M)) (C : BaseContext M)

def rawVolumeObjectClass {n : ℕ} (U : RVVolumeObject (M := M) (C.base : Set M) n) :
    RawRVVolumeRing hc C := semiringGroupificationOf _ (volumeIsoSemiringClass hc C U)

def rawBasicVolumeDifference : RawRVVolumeRing hc C :=
  rawVolumeObjectClass hc C (n := 1) (degreeOnePointVolumeObject (C.base : Set M)) -
    rawVolumeObjectClass hc C (n := 1) (degreeOneConeVolumeObject (C.base : Set M))

def basicVolumeRelationIdeal : Ideal (RawRVVolumeRing hc C) :=
  (TwoSidedIdeal.span {rawBasicVolumeDifference hc C}).asIdeal

instance basicVolumeRelationIdealTwoSided : (basicVolumeRelationIdeal hc C).IsTwoSided :=
  inferInstanceAs (TwoSidedIdeal.span {rawBasicVolumeDifference hc C}).asIdeal.IsTwoSided

theorem raw_basic_volume_difference_mem_kernel :
    rawBasicVolumeDifference hc C ∈ rawVolumeKernelIdeal hc C := by
  apply RingHom.mem_ker.mpr
  change rawVolumeBlowupRingProjection hc C
    (semiringGroupificationOf _ (volumeIsoSemiringClass hc C (n := 1) (degreeOnePointVolumeObject (C.base : Set M))) -
      semiringGroupificationOf _ (volumeIsoSemiringClass hc C (n := 1) (degreeOneConeVolumeObject (C.base : Set M)))) = 0
  rw [map_sub]
  change semiringGroupificationMap (rvVolumeGradedBlowupProjection hc C) _ -
    semiringGroupificationMap (rvVolumeGradedBlowupProjection hc C) _ = 0
  rw [semiringGroupificationMap_of,semiringGroupificationMap_of,basic_volume_relation_projection]
  exact sub_self _

theorem raw_volume_kernel_principal :
    rawVolumeKernelIdeal hc C = basicVolumeRelationIdeal hc C := by
  have hle : basicVolumeRelationIdeal hc C ≤ rawVolumeKernelIdeal hc C := by
    have h : TwoSidedIdeal.span {rawBasicVolumeDifference hc C} ≤ (rawVolumeKernelIdeal hc C).toTwoSided := by
      apply TwoSidedIdeal.span_le.mpr
      intro x hx
      apply Ideal.mem_toTwoSided.mpr
      exact (Set.mem_singleton_iff.mp hx) ▸ raw_basic_volume_difference_mem_kernel hc C
    intro x hx
    exact Ideal.mem_toTwoSided.mp (h hx)
  apply le_antisymm _ hle
  let I := basicVolumeRelationIdeal hc C
  let q := Ideal.Quotient.mk I
  let f := q.comp (semiringGroupificationOf (RVVolumeIsoSemiring hc C))
  have hBasic : f (volumeIsoSemiringClass hc C (n := 1) (degreeOnePointVolumeObject (C.base : Set M))) =
      f (volumeIsoSemiringClass hc C (n := 1) (degreeOneConeVolumeObject (C.base : Set M))) := by
    apply sub_eq_zero.mp
    change q (rawVolumeObjectClass hc C (n := 1) (degreeOnePointVolumeObject (C.base : Set M))) -
      q (rawVolumeObjectClass hc C (n := 1) (degreeOneConeVolumeObject (C.base : Set M))) = 0
    rw [← map_sub]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (TwoSidedIdeal.subset_span (Set.mem_singleton _))
  have hrel : ∀ n (U V : RVVolumeObject (M := M) (C.base : Set M) n),
      MuIsp (C.base : Set M) n U V → f (volumeIsoSemiringClass hc C U) = f (volumeIsoSemiringClass hc C V) := by
    intro n U V hUV
    cases n with
    | zero => exact congrArg f (congrArg (DirectSum.of (RVVolumeIsoClasses hc C) 0) (Quotient.sound hUV))
    | succ k => exact common_blowup_image_eq_of_basic hc C f hBasic hUV
  let g := semiringGroupificationLift (volumeBlowupUniversalDescend hc C f hrel)
  have hg : g.comp (rawVolumeBlowupRingProjection hc C) = q := by
    apply semiringGroupification_hom_ext
    intro a
    change g (semiringGroupificationMap (rvVolumeGradedBlowupProjection hc C)
      (semiringGroupificationOf _ a)) = f a
    rw [semiringGroupificationMap_of]
    change semiringGroupificationLift _ (semiringGroupificationOf _ _) = f a
    rw [semiringGroupificationLift_of]
    exact RingHom.congr_fun (volume_blowup_universal_descend_projection hc C f hrel) a
  intro x hx
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  have he := RingHom.congr_fun hg x
  rw [RingHom.comp_apply,RingHom.mem_ker.mp hx,map_zero] at he
  exact he.symm

def principalVolumeKernelQuotientEquiv :
    (RawRVVolumeRing hc C ⧸ basicVolumeRelationIdeal hc C) ≃+* RVVolumeBlowupRing hc C :=
  (Ideal.quotEquivOfEq (raw_volume_kernel_principal hc C).symm).trans (rawVolumeKernelIdealQuotientEquiv hc C)

end IntegrationInACVF.Section7.HK
