import IntegrationSection2.PrimitiveResidueLift
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic

/-! A monic lift of a primitive residue polynomial has exactly the
residue degree as the degree of the subextension it generates. This
does not assert that the original finite extension is generated by it. -/

set_option backward.isDefEq.respectTransparency false

open IsLocalRing Polynomial Module IntermediateField
open SpecialTransformations.Section9

namespace IntegrationInACVF.Section2.PrimitiveResidueDegree

variable {K Γ : Type*} [Field K] [LinearOrderedCommGroupWithZero Γ]
  (v : Valuation K Γ) (F : Subfield K)

theorem field_root (P : Polynomial (v.comap F.subtype).valuationSubring)
    (u : v.valuationSubring) (hu : (P.map (valuationRingInclusion v F)).IsRoot u) :
    aeval (u:K) (P.map (v.comap F.subtype).valuationSubring.subtype) = 0 := by
  let A := (v.comap F.subtype).valuationSubring
  let B := v.valuationSubring
  have hpoly : (P.map (valuationRingInclusion v F)).map B.subtype =
      (P.map A.subtype).map F.subtype := by
    rw [Polynomial.map_map,Polynomial.map_map]
    congr 1
  have h := congrArg B.subtype hu
  change B.subtype ((P.map (valuationRingInclusion v F)).eval u) = B.subtype 0 at h
  rw [← Polynomial.eval_map_apply,hpoly,map_zero] at h
  rw [← Subfield.algebraMap_ofSubfield F,Polynomial.eval_map_algebraMap] at h
  exact h

theorem independent_powers (u : v.valuationSubring) :
    letI := (residueFieldInclusion v F).toAlgebra
    ∀ pb : PowerBasis (ResidueField (v.comap F.subtype).valuationSubring) (ResidueField v.valuationSubring),
      residue v.valuationSubring u = pb.gen → LinearIndependent F (fun i : Fin pb.dim => (u:K)^(i:ℕ)) := by
  letI := (residueFieldInclusion v F).toAlgebra
  intro pb hu
  let up (i : Fin pb.dim) : v.valuationSubring := u^(i:ℕ)
  have hInd : LinearIndependent (ResidueField (v.comap F.subtype).valuationSubring)
      (fun i => residue v.valuationSubring (up i)) := by
    have he : (fun i => residue v.valuationSubring (up i)) = pb.basis := by
      funext i
      simp only [up,map_pow,hu,pb.basis_eq_pow]
    rw [he]
    exact pb.basis.linearIndependent
  have h := ResidueIndependentLifts.independent v F up hInd
  have he : (fun i => (up i : K)) = (fun i : Fin pb.dim => (u:K)^(i:ℕ)) := by
    funext i
    exact map_pow v.valuationSubring.subtype u (i:ℕ)
  rw [he] at h
  exact h

theorem generated_degree (u : v.valuationSubring)
    (P : Polynomial (v.comap F.subtype).valuationSubring) (hPm : P.Monic)
    (hroot : (P.map (valuationRingInclusion v F)).IsRoot u) :
    letI := (residueFieldInclusion v F).toAlgebra
    ∀ pb : PowerBasis (ResidueField (v.comap F.subtype).valuationSubring) (ResidueField v.valuationSubring),
      residue v.valuationSubring u = pb.gen →
      P.map (residue (v.comap F.subtype).valuationSubring) = minpoly _ pb.gen →
      Module.finrank F F⟮(u:K)⟯ =
        Module.finrank (ResidueField (v.comap F.subtype).valuationSubring) (ResidueField v.valuationSubring) := by
  letI := (residueFieldInclusion v F).toAlgebra
  intro pb hu hred
  let A := (v.comap F.subtype).valuationSubring
  let L := F⟮(u:K)⟯
  let α : L := AdjoinSimple.gen F (u:K)
  have hfroot := field_root v F P u hroot
  have hint : IsIntegral F (u:K) := ⟨P.map A.subtype,hPm.map A.subtype,hfroot⟩
  letI := adjoin.finiteDimensional hint
  have hLI : LinearIndependent F (fun i : Fin pb.dim => (u:K)^(i:ℕ)) := independent_powers v F u pb hu
  have hL : LinearIndependent F (fun i : Fin pb.dim => α^(i:ℕ)) := by
    apply LinearIndependent.of_comp L.val.toLinearMap
    have he : L.val.toLinearMap ∘ (fun i : Fin pb.dim => α^(i:ℕ)) =
        (fun i : Fin pb.dim => (u:K)^(i:ℕ)) := by
      funext i
      change L.val (α^(i:ℕ)) = _
      rw [map_pow]
      rfl
    rw [he]
    exact hLI
  have hlo : pb.dim ≤ Module.finrank F L := by
    simpa only [Fintype.card_fin] using hL.fintype_card_le_finrank
  have hPdeg : P.natDegree = pb.dim := by
    calc
      _ = (P.map (residue A)).natDegree := (hPm.natDegree_map _).symm
      _ = (minpoly _ pb.gen).natDegree := congrArg Polynomial.natDegree hred
      _ = pb.dim := pb.natDegree_minpoly
  have hhi : Module.finrank F L ≤ pb.dim := by
    rw [adjoin.finrank hint,← hPdeg]
    have hbound := Polynomial.natDegree_le_of_dvd (minpoly.dvd F (u:K) hfroot) (hPm.map A.subtype).ne_zero
    exact hbound.trans_eq (hPm.natDegree_map _)
  rw [pb.finrank]
  exact hhi.antisymm hlo

end IntegrationInACVF.Section2.PrimitiveResidueDegree
